{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "forge",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arjunganesh.forge"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "package": "com.arjunganesh.forge",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "PACKAGE_USAGE_STATS",
        "QUERY_ALL_PACKAGES",
        "SYSTEM_ALERT_WINDOW",
        "BIND_ACCESSIBILITY_SERVICE",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Forge needs the camera to scan food and analyze your physique."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge needs photo access to analyze meals and outfits."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE-WITH-YOUR-EAS-PROJECT-ID"
      }
    }
  }
}
